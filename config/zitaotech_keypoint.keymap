#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESCAPE        &kp Q         &kp W          &kp E          &kp R  &kp T      &kp Y      &kp U      &kp I       &kp O       &kp P          &kp BACKSPACE
&kp TAB           &kp A         &kp S          &kp D          &kp F  &kp G      &mkp LCLK  &mkp LCLK  &kp H       &kp J       &kp K          &kp L          &kp UP_ARROW       &kp RIGHT_SHIFT
&kp LEFT_SHIFT    &kp Z         &kp X          &kp C          &kp V  &kp B      &kp RET    &mkp MB2   &kp ESCAPE  &mkp MB2    &kp N          &kp M          &kp SLASH          &kp LEFT         &kp DOWN  &kp RIGHT
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp RIGHT_GUI  &kp RIGHT_ALT  &mo 1  &kp SPACE  &mo 2      &mo 2      &kp COMMA   &kp PERIOD  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RET
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN_ARROW UP_ARROW>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp LA(LG(ESCAPE))                    &kp F12       &kp F2        &kp LG(E)      &kp LC(R)  &kp LC(T)      &mkp MB1  &mkp MB2  &kp INS   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp LC(A)     &kp LC(S)     &kp LC(D)      &kp LC(F)  &kp F5         &mkp MB1  &mkp MB1  &kp HOME  &kp END               &kp PAGE_UP            &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp NON_US_BSLH
&kp LEFT_SHIFT                        &kp LC(Z)     &kp LC(X)     &kp LC(C)      &kp LC(V)  &kp LA(LC(V))  &trans    &trans    &trans    &trans                &kp LC(PAGE_UP)        &kp LC(PAGE_DOWN)  &kp PAGE_DOWN      &kp SEMI         &kp APOSTROPHE  &kp GRAVE
&kp LEFT_CONTROL                      &kp LEFT_ALT  &kp LEFT_GUI  &kp RIGHT_ALT  &mo 4      &kp RET        &mo 4     &mo 4     &none     &trans                &trans                 &trans             &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT LEFT>,
                <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp ESCAPE        &kp LA(F4)       &kp LC(F4)         &kp HOME       &kp END       &kp PAGE_UP      &kp N7    &kp N8  &kp N9        &kp MINUS   &kp EQUAL      &kp DEL
&kp TAB           &kp LC(PLUS)     &kp LC(MINUS)      &kp DELETE     &kp UP_ARROW  &kp PAGE_DOWN    &mkp MB1  &none   &kp NUMBER_4  &kp N5      &kp NUMBER_6   &kp PLUS       &kp UP_ARROW       &kp RIGHT_SHIFT
&kp LEFT_SHIFT    &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LEFT       &kp DOWN      &kp RIGHT_ARROW  &trans    &trans  &kp HOME      &kp END     &kp NUMBER_1   &kp NUMBER_2   &kp NUMBER_3       &kp LEFT         &kp DOWN  &kp RIGHT
&kp LEFT_CONTROL  &kp LEFT_ALT     &kp LEFT_GUI       &kp RIGHT_ALT  &mo 4         &kp SPACE        &mo 4     &mo 4   &kp N0        &kp PERIOD  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RET
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp TAB    &kp Q         &kp W         &kp E  &kp R  &kp T      &mkp MB1   &mkp MB2   &kp I       &kp O       &kp P          &kp BSPC
&kp CAPS   &kp A         &kp S         &kp D  &kp F  &kp G      &mkp LCLK  &mkp LCLK  &none       &mkp MB3    &none          &kp L          &kp UP_ARROW       &kp RIGHT_SHIFT
&kp LSHFT  &kp Z         &kp X         &kp C  &kp V  &kp B      &kp RET    &mkp MB2   &kp ESCAPE  &mkp MB2    &kp N          &kp M          &kp SLASH          &kp LEFT         &kp DOWN  &kp RIGHT
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &none  &none  &kp SPACE  &none      &none      &kp COMMA   &kp PERIOD  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RET
            >;

            sensor-bindings =
                <&inc_dec_kp DOWN UP_ARROW>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&kp ESCAPE           &kp F1        &kp F2        &kp F3      &kp F4  &kp F5       &bt BT_CLR  &none  &kp INS       &kp MINUS   &kp PRINTSCREEN  &kp DELETE
&mt KP_NUM CAPSLOCK  &kp F6        &kp F7        &kp F8      &kp F9  &kp F10      &none       &none  &out OUT_TOG  &none       &none            &kp PLUS       &trans             &kp RIGHT_SHIFT
&kp LEFT_SHIFT       &kp F11       &kp F12       &none       &none   &bootloader  &none       &none  &bl BL_DEC    &bl BL_INC  &bootloader      &none          &none              &trans           &trans  &trans
&kp LEFT_CONTROL     &kp LEFT_ALT  &kp LEFT_GUI  &kp C_MUTE  &none   &none        &none       &none  &none         &none       &kp RIGHT_ALT    &kp RIGHT_GUI  &kp RIGHT_CONTROL  &kp RET
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>,
                <&BLE_encoder>;
        };
    };
};
